# ── Kentik API credentials ──────────────────────────────────────────────────
# Your Kentik account email address
KENTIK_API_EMAIL=you@yourcompany.com

# Your Kentik API token (from https://portal.kentik.com → Account Settings)
KENTIK_API_TOKEN=your_kentik_api_token_here

# ── Google Chronicle / SecOps ────────────────────────────────────────────────
# Your Chronicle instance ID (UUID shown in the Chronicle URL or onboarding docs)
CHRONICLE_CUSTOMER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The GCP project ID that is linked to your Chronicle instance
CHRONICLE_PROJECT_ID=your-gcp-project-id

# Chronicle API region: us | europe | asia  (default: us)
CHRONICLE_REGION=us

# ── Google Authentication (choose one) ───────────────────────────────────────
# Option A — path to a GCP service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option B — run `gcloud auth application-default login` and leave this unset
